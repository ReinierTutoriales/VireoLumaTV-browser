# Build output (every module's build/ folder, Gradle and Kotlin caches)
build/
.gradle/
.kotlin/
native/adblock-jni/target/

# Machine-specific settings and IDE files
local.properties
.idea/
*.iml
.DS_Store

# Never commit signing keys or memory dumps
*.jks
*.keystore
*.hprof

# Generated Python bytecode
__pycache__/
*.pyc
