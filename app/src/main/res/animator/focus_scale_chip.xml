<?xml version="1.0" encoding="utf-8"?>
<!-- Focus grows the item by 1.05x, the TV focus-system step for its size; brief, so the remote feels direct. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.05" android:duration="@integer/focus_ms" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.05" android:duration="@integer/focus_ms" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="@integer/focus_ms" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="@integer/focus_ms" android:valueType="floatType" />
        </set>
    </item>
</selector>
