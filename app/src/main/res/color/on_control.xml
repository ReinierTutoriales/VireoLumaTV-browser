<?xml version="1.0" encoding="utf-8"?>
<!-- Content of a control: dark on the inverted focused surface, dimmed when disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/inverse_on_surface" />
    <item android:state_enabled="false" android:alpha="0.38" android:color="@color/on_surface" />
    <item android:color="@color/on_surface" />
</selector>
