<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon control: invisible until focused, then a light disc under dark content. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="@color/on_surface_variant" /></shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="@color/focus_halo_outer" /></shape></item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape android:shape="oval"><solid android:color="@color/focus_halo_inner" /></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval"><solid android:color="@color/inverse_surface" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval"><solid android:color="@color/brand_container" /></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@android:color/transparent" /></shape>
    </item>
</selector>
