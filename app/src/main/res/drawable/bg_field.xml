<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: it keeps its dark surface while focused (the caret and text stay readable)
     and gains a light outline instead of inverting. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/corner_large" />
            <solid android:color="@color/surface_high" />
            <stroke android:width="3dp" android:color="@color/inverse_surface" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/corner_large" />
            <solid android:color="@color/surface_variant" />
        </shape>
    </item>
</selector>
