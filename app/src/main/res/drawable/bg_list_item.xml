<?xml version="1.0" encoding="utf-8"?>
<!-- Item of a ListView (dialog lists): the list marks the remote's item as selected, not focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="@dimen/corner_small" /><solid android:color="@color/on_surface_variant" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><corners android:radius="@dimen/corner_small" /><solid android:color="@color/inverse_surface" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><corners android:radius="@dimen/corner_small" /><solid android:color="@color/inverse_surface" /></shape>
    </item>
    <item>
        <shape><corners android:radius="@dimen/corner_small" /><solid android:color="@android:color/transparent" /></shape>
    </item>
</selector>
