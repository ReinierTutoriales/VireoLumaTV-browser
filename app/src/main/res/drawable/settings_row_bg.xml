<?xml version="1.0" encoding="utf-8"?>
<!-- Focus and press share one outlined fill so the selected row is visible from a distance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/settings_row_bg_selected" />
    <item android:state_pressed="true" android:drawable="@drawable/settings_row_bg_selected" />
    <item android:drawable="@android:color/transparent" />
</selector>
