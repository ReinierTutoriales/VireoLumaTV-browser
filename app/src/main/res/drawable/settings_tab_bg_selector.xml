<?xml version='1.0' encoding='utf-8'?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_background_pressed" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_tab_color_focused" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/ui_focus_border" />
        </shape>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/settings_tab_color_activated" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:gravity="bottom">
                <shape>
                    <size android:height="2dp" />
                    <solid android:color="@color/settings_tab_activated_underline_color" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_tab_color" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>