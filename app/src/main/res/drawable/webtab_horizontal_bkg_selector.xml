<?xml version="1.0" encoding="utf-8"?>
<!-- Focus draws the shared outline; the open tab keeps a fill. No drawable padding: the layout sizes the tab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/settings_row_bg_selected" />
    <item android:state_focused="true" android:drawable="@drawable/settings_row_bg_selected" />
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/ui_control_checked" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
