<?xml version="1.0" encoding="utf-8"?>
<!-- Commands above the list; 48 dp / 27 dp keeps everything inside the TV overscan-safe area. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/day_night_background_color"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_bg_selector"
            android:minWidth="96dp"
            android:nextFocusDown="@+id/listView"
            android:stateListAnimator="@null"
            android:text="@string/delete"
            android:textColor="@color/day_night_text_color_contrast"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/button_bg_selector"
            android:minWidth="96dp"
            android:nextFocusDown="@+id/listView"
            android:stateListAnimator="@null"
            android:text="@string/clear"
            android:textColor="@color/day_night_text_color_contrast" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="27dp" />
</LinearLayout>
