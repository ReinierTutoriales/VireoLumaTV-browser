<?xml version="1.0" encoding="utf-8"?>
<!-- The side panel: the app name, then the entries; inside the overscan-safe area at the screen edge. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingTop="@dimen/safe_vertical"
    android:paddingEnd="@dimen/safe_horizontal"
    android:paddingBottom="@dimen/safe_vertical">

    <LinearLayout
        android:id="@+id/menuEntries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:paddingStart="16dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Vireo.Title" />
    </LinearLayout>
</ScrollView>
