<?xml version="1.0" encoding="utf-8"?>
<!-- A single-choice item: the chosen one shows the accent mark. -->
<CheckedTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:minHeight="@dimen/row_height"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/bg_list_item"
    android:textColor="@color/on_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:checkMark="?android:attr/listChoiceIndicatorSingle"
    android:checkMarkTint="@color/on_list_item_accent"
    android:ellipsize="end"
    android:maxLines="2"
    android:textAppearance="@style/TextAppearance.Vireo.Body" />
