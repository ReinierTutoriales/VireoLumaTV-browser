<?xml version="1.0" encoding="utf-8"?>
<!-- Title and address are editable at once; Done saves, Cancel closes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:minWidth="520dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.Vireo.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@+id/etTitle"
        android:paddingStart="4dp"
        android:text="@string/field_title"
        android:textAppearance="@style/TextAppearance.Vireo.Secondary" />

    <EditText
        android:id="@id/etTitle"
        style="@style/Widget.Vireo.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:labelFor="@+id/etUrl"
        android:paddingStart="4dp"
        android:text="@string/field_address"
        android:textAppearance="@style/TextAppearance.Vireo.Secondary" />

    <EditText
        android:id="@id/etUrl"
        style="@style/Widget.Vireo.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAutofill="no"
        android:inputType="textUri" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clipChildren="false"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.Vireo.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/control_gap"
            android:text="@string/action_cancel" />

        <Button
            android:id="@+id/btnDone"
            style="@style/Widget.Vireo.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_done" />
    </LinearLayout>
</LinearLayout>
