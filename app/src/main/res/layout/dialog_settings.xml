<?xml version="1.0" encoding="utf-8"?>
<!-- Page tabs on top, the selected page below. Focus alone never switches the page (SettingsPages). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RadioGroup
        android:id="@+id/sbTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@id/btnMainTab"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <RadioButton
            android:id="@+id/btnMainTab"
            style="@style/SettingsTab"
            android:text="@string/main" />

        <RadioButton
            android:id="@+id/btnShortcutsTab"
            style="@style/SettingsTab"
            android:text="@string/shortcuts" />

        <RadioButton
            android:id="@+id/btnVersionTab"
            style="@style/SettingsTab"
            android:text="@string/version_and_updates" />
    </RadioGroup>

    <FrameLayout
        android:id="@+id/flTabsContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
