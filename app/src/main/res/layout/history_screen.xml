<?xml version="1.0" encoding="utf-8"?>
<!-- Commands above the list, all inside the TV overscan-safe area. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:clipChildren="false"
    android:paddingStart="@dimen/safe_horizontal"
    android:paddingTop="@dimen/safe_vertical"
    android:paddingEnd="@dimen/safe_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/delete_selected_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            style="@style/Widget.Vireo.Button"
            android:nextFocusDown="@+id/item_list"
            android:text="@string/action_delete"
            android:visibility="gone" />

        <Button
            android:id="@+id/clear_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Widget.Vireo.Button"
            android:nextFocusDown="@+id/item_list"
            android:text="@string/action_clear" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/item_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/safe_vertical" />
</LinearLayout>
