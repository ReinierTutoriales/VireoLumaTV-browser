<?xml version="1.0" encoding="utf-8"?>
<!-- Side panel: actions on top (add the page shown, edit mode), then the favorites or an empty-state hint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="@dimen/safe_vertical"
    android:paddingEnd="@dimen/safe_horizontal"
    android:paddingBottom="@dimen/safe_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:paddingStart="16dp"
        android:text="@string/menu_favorites"
        android:textAppearance="@style/TextAppearance.Vireo.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/add_button"
            style="@style/Widget.Vireo.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/control_gap"
            android:text="@string/favorites_add" />

        <Button
            android:id="@+id/edit_button"
            style="@style/Widget.Vireo.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_edit" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/item_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/favorites_empty"
            android:textAppearance="@style/TextAppearance.Vireo.Body"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/loading_spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand" />
    </FrameLayout>
</LinearLayout>
