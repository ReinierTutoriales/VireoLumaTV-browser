<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="horizontal">

  <!-- One focus row: address field, page commands, blocker state, application menu. -->
  <FrameLayout
      android:layout_width="0dp"
      android:layout_weight="1"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:id="@+id/flUrl">
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@drawable/browser_address_bg"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical"
        android:fontFamily="sans-serif"
        android:textSize="20sp"
        android:textColorHint="@color/ui_url_hint"
        android:singleLine="true"
        android:id="@+id/etUrl"
        android:nextFocusRight="@id/ibBack"
        android:nextFocusDown="@id/vTabs"
        android:iconifiedByDefault="false"
        android:textCursorDrawable="@null"
        android:textColor="@color/default_url_color"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:hint="@string/url_prompt"
        android:inputType="textUri"
        android:importantForAutofill="no" />
  </FrameLayout>

  <ImageButton
      style="@style/BrowserControl"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginEnd="4dp"
      android:id="@+id/ibBack"
      android:contentDescription="@string/navigate_back"
      android:src="@drawable/back_icon_selector"
      android:nextFocusLeft="@id/etUrl"
      android:nextFocusRight="@id/ibForward"
      android:nextFocusDown="@id/vTabs" />

  <ImageButton
      style="@style/BrowserControl"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginEnd="4dp"
      android:id="@+id/ibForward"
      android:contentDescription="@string/navigate_forward"
      android:src="@drawable/forward_icon_selector"
      android:nextFocusLeft="@id/ibBack"
      android:nextFocusRight="@id/ibRefresh"
      android:nextFocusDown="@id/vTabs" />

  <ImageButton
      style="@style/BrowserControl"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginEnd="4dp"
      android:id="@+id/ibRefresh"
      android:contentDescription="@string/refresh_page"
      android:src="@drawable/ic_refresh_grey_900_24dp"
      android:nextFocusLeft="@id/ibForward"
      android:nextFocusRight="@id/ibHome"
      android:nextFocusDown="@id/vTabs" />

  <ImageButton
      style="@style/BrowserControl"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginEnd="4dp"
      android:id="@+id/ibHome"
      android:contentDescription="@string/navigate_home"
      android:src="@drawable/ic_home_grey_900_24dp"
      android:nextFocusLeft="@id/ibRefresh"
      android:nextFocusRight="@id/ibAdBlock"
      android:nextFocusDown="@id/vTabs" />

  <!-- Click toggles blocking; long press opens the blocker details. -->
  <ImageButton
      style="@style/BrowserControl"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginEnd="4dp"
      android:id="@+id/ibAdBlock"
      android:contentDescription="@string/toggle_ads_blocking"
      android:src="@drawable/ic_adblock_on"
      android:nextFocusLeft="@id/ibHome"
      android:nextFocusRight="@id/ibMenu"
      android:nextFocusDown="@id/vTabs" />

  <ImageButton
      style="@style/BrowserControl"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:id="@+id/ibMenu"
      android:contentDescription="@string/app_menu"
      android:src="@drawable/ic_menu_24"
      android:nextFocusLeft="@id/ibAdBlock"
      android:nextFocusDown="@id/vTabs"
      android:focusable="true"
      android:focusableInTouchMode="true" />
</merge>
