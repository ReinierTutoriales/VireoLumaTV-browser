<?xml version="1.0" encoding="utf-8"?>
<!-- One focus row: the address, the page commands, the blocker shield (long press: details) and the menu. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <FrameLayout
        android:id="@+id/flUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_weight="1">

        <EditText
            android:id="@+id/etUrl"
            style="@style/Widget.Vireo.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:hint="@string/address_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:nextFocusRight="@id/ibBack"
            android:nextFocusDown="@id/vTabs" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/ibBack"
        style="@style/Widget.Vireo.IconButton"
        android:layout_marginEnd="@dimen/control_gap"
        android:contentDescription="@string/nav_back"
        android:src="@drawable/ic_back"
        android:nextFocusLeft="@id/etUrl"
        android:nextFocusRight="@id/ibForward"
        android:nextFocusDown="@id/vTabs" />

    <ImageButton
        android:id="@+id/ibForward"
        style="@style/Widget.Vireo.IconButton"
        android:layout_marginEnd="@dimen/control_gap"
        android:contentDescription="@string/nav_forward"
        android:src="@drawable/ic_forward"
        android:nextFocusLeft="@id/ibBack"
        android:nextFocusRight="@id/ibRefresh"
        android:nextFocusDown="@id/vTabs" />

    <ImageButton
        android:id="@+id/ibRefresh"
        style="@style/Widget.Vireo.IconButton"
        android:layout_marginEnd="@dimen/control_gap"
        android:contentDescription="@string/nav_reload"
        android:src="@drawable/ic_refresh"
        android:nextFocusLeft="@id/ibForward"
        android:nextFocusRight="@id/ibHome"
        android:nextFocusDown="@id/vTabs" />

    <ImageButton
        android:id="@+id/ibHome"
        style="@style/Widget.Vireo.IconButton"
        android:layout_marginEnd="@dimen/control_gap"
        android:contentDescription="@string/nav_home"
        android:src="@drawable/ic_home"
        android:nextFocusLeft="@id/ibRefresh"
        android:nextFocusRight="@id/ibAdBlock"
        android:nextFocusDown="@id/vTabs" />

    <ImageButton
        android:id="@+id/ibAdBlock"
        style="@style/Widget.Vireo.IconButton"
        android:layout_marginEnd="@dimen/control_gap"
        android:contentDescription="@string/blocker_toggle"
        android:src="@drawable/ic_shield_on"
        android:nextFocusLeft="@id/ibHome"
        android:nextFocusRight="@id/ibMenu"
        android:nextFocusDown="@id/vTabs" />

    <ImageButton
        android:id="@+id/ibMenu"
        style="@style/Widget.Vireo.IconButton"
        android:contentDescription="@string/nav_menu"
        android:src="@drawable/ic_more"
        android:nextFocusLeft="@id/ibAdBlock"
        android:nextFocusDown="@id/vTabs" />
</merge>
