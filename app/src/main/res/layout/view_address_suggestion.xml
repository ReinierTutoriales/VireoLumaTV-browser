<?xml version="1.0" encoding="utf-8"?>
<!-- One address suggestion: OK opens it. Compact, single focus stop. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:background="@drawable/list_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/ivKind"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="420dp"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="16sp" />

    <!-- Takes the rest of the row; no weight, so the row is measured once. -->
    <TextView
        android:id="@+id/tvUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/day_night_text_color"
        android:textSize="14sp" />
</LinearLayout>
