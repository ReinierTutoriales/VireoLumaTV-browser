<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="170dp">

    <ImageButton
        style="@style/BrowserControl"
        android:id="@+id/btnGrabMode"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/button_bg_selector"
        android:src="@drawable/ic_circle_plus"
        android:contentDescription="@string/cursor_grab_mode"
        app:tint="@color/day_night_icon_color"
        android:defaultFocusHighlightEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        style="@style/BrowserControl"
        android:id="@+id/btnZoomIn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="fitCenter"
        android:background="@drawable/button_bg_selector"
        android:src="@drawable/ic_zoom_in_gray_24dp"
        android:contentDescription="@string/zoom_in"
        app:tint="@color/day_night_icon_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/BrowserControl"
        android:id="@+id/btnZoomOut"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="fitCenter"
        android:background="@drawable/button_bg_selector"
        android:src="@drawable/ic_zoom_out_gray_24dp"
        android:contentDescription="@string/zoom_out"
        app:tint="@color/day_night_icon_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/BrowserControl"
        android:id="@+id/btnContextMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="fitCenter"
        android:background="@drawable/button_bg_selector"
        android:src="@drawable/ic_menu_24"
        android:contentDescription="@string/link_actions"
        app:tint="@color/day_night_icon_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/BrowserControl"
        android:id="@+id/btnDPADMode"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="fitCenter"
        android:background="@drawable/button_bg_selector"
        android:src="@drawable/gamepad_circle_up_24px"
        android:contentDescription="@string/direct_navigation_mode_title"
        app:tint="@color/day_night_icon_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
