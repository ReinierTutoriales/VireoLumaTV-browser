<?xml version="1.0" encoding="utf-8"?>
<!-- One bookmark: the row opens it (or edits it in edit mode); Delete appears only in edit mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/llContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_row"
        android:stateListAnimator="@animator/focus_scale_row"
        android:defaultFocusHighlightEnabled="false"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/row_height"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/ivIcon"
            android:duplicateParentState="true"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <!-- Takes the space left by the icon; no nested weight, so each row is measured once. -->
        <LinearLayout
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_control"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvUrl"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/on_control_variant"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/ibDelete"
        style="@style/Widget.Vireo.IconButton"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_delete"
        android:visibility="gone" />
</LinearLayout>
