<?xml version="1.0" encoding="utf-8"?>
<!-- Compact tab: 196dp is the TV grid's four-card width, so four tabs and "+" fit the capsule.
     The open tab is View.isSelected: drawn by the selector and announced by accessibility services. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/web_tab_width"
    android:layout_height="@dimen/web_tab_height"
    android:layout_marginEnd="4dp"
    android:background="@drawable/webtab_horizontal_bkg_selector"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:nextFocusUp="@+id/etUrl"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    tools:targetApi="26">

    <ImageView
        android:id="@+id/ivFavicon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_launcher" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="14sp"
        tools:text="@string/app_name" />
</LinearLayout>
