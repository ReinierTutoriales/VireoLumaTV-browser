<?xml version="1.0" encoding="utf-8"?>
<!-- A labelled choice: the spinner is the focus stop; its options open in a centred dialog,
     which is never cut by the screen edge as a drop-down near the bottom is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:clipChildren="false"
    android:orientation="vertical">

    <TextView
        android:id="@+id/settingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textAppearance="@style/TextAppearance.Vireo.Secondary" />

    <Spinner
        android:id="@+id/settingControl"
        style="@style/Widget.AppCompat.Spinner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_height"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_row"
        android:defaultFocusHighlightEnabled="false"
        android:paddingStart="8dp"
        android:spinnerMode="dialog"
        android:stateListAnimator="@animator/focus_scale_row" />
</LinearLayout>
