<?xml version="1.0" encoding="utf-8"?>
<!-- One fixed dark palette: an opaque black backdrop (the same as pages loading behind it), layered
     neutral surfaces with hairline edges, readable text and distinct remote focus states
     (focus inverts, as on Google TV). -->
<resources>
    <color name="background">#000000</color>
    <color name="surface">#000000</color>
    <color name="surface_variant">#151515</color>
    <color name="surface_high">#242424</color>
    <color name="outline">#404040</color>
    <color name="on_surface">#F2F2F2</color>
    <color name="on_surface_variant">#B5B5B5</color>
    <color name="inverse_surface">#F2F2F2</color>
    <color name="inverse_on_surface">#101010</color>
    <color name="brand">#7BD88F</color>
    <color name="brand_container">#1B3D2A</color>
    <!-- Focus halo: the brand color at 20 % (outer ring) and 40 % (inner ring) opacity. -->
    <color name="focus_halo_outer">#337BD88F</color>
    <color name="focus_halo_inner">#667BD88F</color>
    <color name="error">#FF8A80</color>
    <color name="scrim_strong">#F2000000</color>
    <color name="scrim_clear">#00000000</color>
</resources>
