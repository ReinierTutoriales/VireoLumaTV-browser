    <color name="surface">#0D1117</color>
    <color name="surface_variant">#1A2029</color>
    <color name="surface_high">#262D38</color>
    <color name="outline">#333B49</color>
    <color name="on_surface">#E8ECF2</color>
    <color name="on_surface_variant">#A9B2C0</color>
    <color name="inverse_surface">#E8ECF2</color>
    <color name="inverse_on_surface">#10141B</color>
    <color name="brand">#7BD88F</color>
    <color name="brand_container">#1B3D2A</color>
    <color name="error">#FF8A80</color>
    <color name="scrim_strong">#F2000000</color>
    <color name="scrim_clear">#00000000</color>
</resources>
