<?xml version="1.0" encoding="utf-8"?>
<!-- Type scale and controls for viewing from a distance; sizes on the 960 x 540 dp TV canvas. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="TextAppearance.Vireo.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="TextAppearance.Vireo.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/on_control</item>
    </style>
    <style name="TextAppearance.Vireo.Secondary" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/on_control_variant</item>
    </style>
    <style name="TextAppearance.Vireo.Label" parent="TextAppearance.AppCompat">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_control</item>
    </style>
    <style name="TextAppearance.Vireo.Overline" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Round icon button: 48 dp target, grows 1.1x and inverts on focus. -->
    <style name="Widget.Vireo.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/control_size</item>
        <item name="android:layout_height">@dimen/control_size</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:padding">@dimen/control_icon_padding</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_control</item>
        <item name="tint">@color/on_control</item>
        <item name="android:stateListAnimator">@animator/focus_scale_control</item>
        <item name="android:focusable">true</item>
        <item name="android:defaultFocusHighlightEnabled" tools:targetApi="26">false</item>
    </style>

    <!-- Text button: a pill that grows 1.05x and inverts on focus. -->
    <style name="Widget.Vireo.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">@dimen/control_size</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textAppearance">@style/TextAppearance.Vireo.Label</item>
        <item name="android:textColor">@color/on_control</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/focus_scale_chip</item>
        <item name="android:defaultFocusHighlightEnabled" tools:targetApi="26">false</item>
    </style>

    <!-- Focusable list row: flat, inverted on focus, grows 1.025x. -->
    <style name="Widget.Vireo.Row" parent="">
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:stateListAnimator">@animator/focus_scale_row</item>
        <item name="android:focusable">true</item>
        <item name="android:defaultFocusHighlightEnabled" tools:targetApi="26">false</item>
    </style>

    <!-- Single-line text field with the field surface. -->
    <style name="Widget.Vireo.Field" parent="Widget.AppCompat.EditText">
        <item name="android:minHeight">@dimen/control_size</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textAppearance">@style/TextAppearance.Vireo.Body</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:singleLine">true</item>
        <item name="android:defaultFocusHighlightEnabled" tools:targetApi="26">false</item>
    </style>

    <!-- Dialog actions: the same pills as everywhere else. -->
    <style name="Widget.Vireo.DialogButton" parent="Widget.Vireo.Button">
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="Widget.Vireo.AlertDialog" parent="AlertDialog.AppCompat">
        <item name="listItemLayout">@layout/dialog_list_item</item>
        <item name="singleChoiceItemLayout">@layout/dialog_choice_item</item>
        <item name="multiChoiceItemLayout">@layout/dialog_check_item</item>
    </style>

    <!-- Dialog lists draw the remote's item themselves (bg_list_item); no extra selector. -->
    <style name="Widget.Vireo.DialogList" parent="Widget.AppCompat.ListView">
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <!-- Settings tab in the settings dialog. -->
    <style name="Widget.Vireo.Tab" parent="Widget.Vireo.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
